[Unit]
Description=OmaSpotify plugin playback backend
Documentation=https://github.com/atlastimed/omaspotify
After=graphical-session.target sound.target
Wants=sound.target

StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
Environment=PULSE_LATENCY_MSEC=250
Environment=TOKIO_WORKER_THREADS=2
ExecStart=@BACKEND_BINARY@ --config-path=@CONFIG_FILE@
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=75 77 78
TimeoutStopSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
LimitCORE=0
LockPersonality=true
RestrictSUIDSGID=true
RestrictNamespaces=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
